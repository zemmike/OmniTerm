# OmniTerm environment (all optional — a saved settings file wins over these)
#
# The assistant is provider-agnostic and there is no AI tab in the UI: configure
# it either with these variables (scripted/headless setups) or by writing
# ~/.local/share/omniterm/ai-config.json yourself (0600). Settings saved in that
# file take precedence over the environment. See the AI section of the README.

# Which shape to speak: openai (any OpenAI-compatible endpoint), anthropic,
# gemini, or ollama (a local daemon — no key, nothing leaves the machine).
# OMNITERM_AI_PROVIDER="openai"

# Endpoint. Examples:
#   local, private ... http://127.0.0.1:11434        (Ollama)
#                      http://127.0.0.1:1234/v1      (LM Studio)
#                      http://127.0.0.1:8080/v1      (llama.cpp server)
#   cloud ............ https://api.openai.com/v1
#                      https://openrouter.ai/api/v1
#                      https://api.groq.com/openai/v1
#                      https://api.deepseek.com/v1
#                      https://api.mistral.ai/v1
# OMNITERM_AI_BASE_URL=""

# Model name.
# OMNITERM_AI_MODEL=""

# API key for cloud providers. OPENAI_API_KEY and ANTHROPIC_API_KEY are also
# read, and GEMINI_API_KEY / GOOGLE_API_KEY act as a Gemini shortcut.
# OMNITERM_AI_API_KEY=""

# Where the settings file lives (default: <data dir>/ai-config.json)
# OMNITERM_AI_CONFIG=""

# Local daemon location and preferred model
# OLLAMA_URL="http://127.0.0.1:11434"
# OMNITERM_OLLAMA_MODEL="llama3.1"

# Per-command execution timeout in milliseconds (default: 60000)
OMNITERM_EXEC_TIMEOUT_MS="60000"

# Hardening knobs used by the desktop shell — leave unset in normal use.
# OMNITERM_HOST="127.0.0.1"
# OMNITERM_TOKEN=""

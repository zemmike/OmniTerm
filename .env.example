# OmniTerm environment (all optional — the app works with none of these set)
#
# These exist for scripted or headless setups. The desktop shell sets the ones it
# needs itself; you normally do not have to touch this file.

# Per-command execution timeout in milliseconds (default: 60000)
OMNITERM_EXEC_TIMEOUT_MS="60000"

# Where OmniTerm keeps its data: the audit log and the backups
# (default: ~/.local/share/omniterm)
# OMNITERM_DATA_DIR=""

# Snapshot location (default: <data dir>/backups)
# OMNITERM_BACKUP_DIR=""

# Refuse mutating commands through the one-shot API and record the attempt
# OMNITERM_READONLY="1"

# Audit log rotation threshold in bytes (default: 8 MB)
# OMNITERM_AUDIT_MAX_BYTES="8388608"

# Hardening knobs used by the desktop shell — leave unset in normal use.
# OMNITERM_HOST="127.0.0.1"
# OMNITERM_TOKEN=""

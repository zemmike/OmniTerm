{
  "name": "omniterm",
  "productName": "OmniTerm",
  "desktopName": "omniterm.desktop",
  "version": "1.6.4",
  "description": "A real Linux terminal emulator: your own shell in tabs and split panes, live host health, file browser and snapshots.",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "license": "MIT",
  "author": {
    "name": "Michael (zemmike)",
    "email": "zemuim@gmail.com"
  },
  "homepage": "https://github.com/zemmike/OmniTerm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemmike/OmniTerm.git"
  },
  "bugs": {
    "url": "https://github.com/zemmike/OmniTerm/issues"
  },
  "keywords": [
    "terminal",
    "electron",
    "shell",
    "developer-tools",
    "linux"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build": "npm run build:web && npm run build:server",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "start": "NODE_ENV=production node dist/server.cjs",
    "start:desktop": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:rpm": "npm run build && electron-builder --linux rpm",
    "dist:tar": "npm run build && electron-builder --linux tar.gz",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "eslint .",
    "test:pty": "node scripts/pty-smoke.cjs",
    "test:pty-socket": "node scripts/pty-socket-test.cjs",
    "test:pty-matrix": "bash scripts/shell-matrix-test.sh",
    "test": "vitest run",
    "test:api": "vitest run tests/api.test.ts",
    "test:pty-features": "node scripts/pty-features-test.cjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:coverage": "NODE_V8_COVERAGE=.coverage-child vitest run --coverage && npm run coverage:server",
    "coverage:server": "c8 report --temp-directory=.coverage-child --reporter=text --reporter=lcov --report-dir=coverage/backend"
  },
  "build": {
    "appId": "app.zemike.omniterm",
    "productName": "OmniTerm",
    "copyright": "Copyright \u00a9 2026 Michael (zemmike)",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "build/icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron-main.cjs"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "tar.gz"
      ],
      "executableName": "omniterm",
      "syncDesktopName": true,
      "category": "Development;Utility;System;TerminalEmulator",
      "icon": "build/icon.png",
      "synopsis": "OmniTerm \u2014 a real Linux terminal with split panes and host health",
      "description": "OmniTerm is a terminal emulator for Linux: real shell sessions in tabs and split panes, prefix history search, per-command exit codes and durations, a colour-coded file browser, live host health for this machine, and snapshots.",
      "maintainer": "Michael (zemmike) <zemuim@gmail.com>",
      "vendor": "zemmike",
      "desktop": {
        "entry": {
          "Name": "OmniTerm",
          "GenericName": "Terminal Emulator",
          "Comment": "A real Linux terminal with split panes and host health",
          "Categories": "Development;System;TerminalEmulator;Utility;",
          "Keywords": "terminal;shell;cli;bash;developer;console;ai;",
          "StartupWMClass": "omniterm",
          "Terminal": "false",
          "Type": "Application"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ],
      "recommends": [
        "libappindicator3-1"
      ],
      "afterInstall": "build/deb-postinst.sh",
      "afterRemove": "build/deb-postrm.sh"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-pty": "^1.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "c8": "^12.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller": false
  }
}

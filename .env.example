# OmniTerm environment (all optional)

# AI copilot — enables the AI Copilot tab and the `ai` terminal command.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Model used by the copilot (default: gemini-2.5-flash)
OMNITERM_AI_MODEL="gemini-2.5-flash"

# Per-command execution timeout in milliseconds (default: 60000)
OMNITERM_EXEC_TIMEOUT_MS="60000"

# Hardening knobs used by the desktop shell — leave unset in normal use.
# OMNITERM_HOST="127.0.0.1"
# OMNITERM_TOKEN=""
